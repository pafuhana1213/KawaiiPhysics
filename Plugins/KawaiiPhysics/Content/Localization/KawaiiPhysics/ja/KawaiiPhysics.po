msgctxt "UObjectToolTips,KawaiiPhysics_ExternalForce_ProceduralWind:DirectionNoisePeriod"
msgid "向きの揺らぎの周期（秒）\nPeriod of the direction wander, in seconds."
msgstr "向きの揺らぎの周期（秒）"

#. Key:	KawaiiPhysics_ExternalForce_ProceduralWind:EnvelopeFrequency
