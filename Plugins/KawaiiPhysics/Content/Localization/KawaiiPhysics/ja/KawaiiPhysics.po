#: /Script/KawaiiPhysics.KawaiiPhysics_ExternalForce_ProceduralWind:DirectionNoisePeriod [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,KawaiiPhysics_ExternalForce_ProceduralWind:DirectionNoisePeriod"
msgid "Direction Noise Period"
msgstr "風向きの揺らぎ周期"

#. Key:	KawaiiPhysics_ExternalForce_ProceduralWind:DirectionNoisePeriod
