	"relations": [
		{"kind": "equal", "vary": {"axis": "space", "a": "cs", "b": "bb"}, "where": {"fixture": ["chain"]}, "except": {"feature": ["wind", "subdivision_free", "sphere", "capsule", "tapered", "box", "plane", "world_floor", "simple_floor"]}, "max_cm": 0.01, "max_degrees": 0.05,
		 "reason": "The chain's base bone never moves in component space, so BaseBoneSpace must match ComponentSpace."},
		{"kind": "equal", "vary": {"axis": "space", "a": "cs", "b": "bb"}, "where": {"fixture": ["chain"], "feature": ["sphere", "capsule", "tapered", "box", "plane"]}, "max_cm": 0.5, "max_degrees": 1.0,
		 "reason": "Contact amplifies rounding: moving a limit by 0.0001 cm separates the same cell by 0.21 cm, so exact agreement does not exist here."},
		{"kind": "equal", "vary": {"axis": "space", "a": "cs", "b": "bb"}, "where": {"fixture": ["chain"], "feature": ["world_floor", "simple_floor"]}, "max_cm": 0.5,
		 "reason": "Floor contact amplifies rounding the same way. The rotation is left out: the tip dummy touching the floor swings the last bone by tens of degrees between runs."},
		{"kind": "equal", "vary": {"axis": "space", "a": "cs", "b": "bb"}, "where": {"fixture": ["chain"], "feature": ["subdivision_free"]}, "max_cm": 0.01, "max_degrees": 0.2,
		 "reason": "Free inter-bone dummies fold and amplify rounding differences, which shows in the rotation before the location."},
		{"kind": "equal", "vary": {"axis": "space", "a": "cs", "b": "ws"}, "where": {"fixture": ["chain"], "motion": ["still"]}, "except": {"feature": ["wind", "floor_off", "world_floor", "simple_floor", "teleport_jump", "teleport_turn"]}, "max_cm": 0.01, "max_degrees": 0.05,
		 "reason": "With the actor at rest, WorldSpace must match ComponentSpace. The floor cells bob up and down and the teleport cells jump, so they do not count as at rest."},
		{"kind": "equal", "vary": {"axis": "place", "a": "near", "b": "far"}, "where": {"fixture": ["chain"]}, "max_cm": 0.01, "max_degrees": 0.05,
		 "reason": "Distance from the origin must not change the result."},
		{"kind": "equal", "vary": {"axis": "space", "a": "cs", "b": "ws"}, "where": {"fixture": ["kano"], "motion": ["still"]}, "max_cm": 0.05, "max_degrees": 0.2,
		 "reason": "With the actor at rest and forces cleared, WorldSpace must match ComponentSpace on the animated character."},
		{"kind": "equal", "vary": {"axis": "space", "a": "cs", "b": "bb"}, "where": {"fixture": ["kano"]}, "max_cm": 0.05, "max_degrees": 0.2,
		 "reason": "The local bone stays fixed in component space, so it must match ComponentSpace on the character too."},
		{"kind": "equal", "id": "switch.cs_to_bb", "a": "reg.cs_to_bb", "b": "kano.bb.still.none.near", "profiles": ["base", "serial", "fps45", "fps120", "dilated"], "skip_frames": 145, "until_frame": 160, "max_cm": 0.05, "max_degrees": 0.5,
		 "reason": "Switching SimulationSpace at frame 150 must not move the output: around the switch the cell must match the one that runs in the target space throughout. Cells that never switch stay within 0.007 cm and 0.11 degrees here; the jump before the fix was 0.96 cm and 3 degrees. The window stops at frame 160 because the accessory chain amplifies tiny differences later on."},
		{"kind": "equal", "id": "switch.ws_to_bb", "a": "reg.ws_to_bb", "b": "kano.bb.still.none.near", "profiles": ["base", "serial", "fps45", "fps120", "dilated"], "skip_frames": 145, "until_frame": 160, "max_cm": 0.05, "max_degrees": 0.5,
		 "reason": "Same check for a switch from WorldSpace to BaseBoneSpace."},
		{"kind": "equal", "id": "switch.cs_to_ws", "a": "reg.cs_to_ws", "b": "kano.ws.still.none.near", "profiles": ["base", "serial", "fps45", "fps120", "dilated"], "skip_frames": 145, "until_frame": 160, "max_cm": 0.05, "max_degrees": 0.5,
		 "reason": "Same check for a switch from ComponentSpace to WorldSpace."},
		{"kind": "equal", "id": "switch.cs_to_ws.fps30", "a": "reg.cs_to_ws", "b": "kano.ws.still.none.near", "profiles": ["fps30"], "skip_frames": 145, "until_frame": 160, "max_cm": 0.05, "max_degrees": 0.5,
		 "reason": "At 30 fps every frame runs two steps. Only the switch to WorldSpace is checked here: ComponentSpace and BaseBoneSpace already separate by 0.28 cm in this window at 30 fps without any switch, while ComponentSpace and WorldSpace stay within 0.015 cm and 0.23 degrees."},

		{"kind": "equal", "vary": {"axis": "feature", "a": "none", "b": "teleport_jump"}, "where": {"fixture": ["chain"], "motion": ["still"], "space": ["cs", "bb"], "place": ["near"]}, "profiles": ["base", "fps45"], "max_cm": 0.01, "max_degrees": 0.05,
		 "reason": "A teleport must discard the whole component move, including the part substepping has not consumed yet. 45 fps leaves such a remainder; 30, 60 and 120 do not."},

		{"kind": "differ", "vary": {"axis": "space", "a": "cs", "b": "ws"}, "where": {"fixture": ["chain"], "motion": ["moving"], "feature": ["none"], "place": ["near"]}, "min_cm": 10.0,
		 "reason": "Negative control: an actor in motion must separate WorldSpace from ComponentSpace, otherwise the equal relations prove nothing."},
		{"kind": "differ", "vary": {"axis": "motion", "a": "still", "b": "moving"}, "where": {"feature": ["none"], "place": ["near"]}, "min_cm": 10.0,
		 "reason": "Negative control: the moving cells must actually move."},
		{"kind": "differ", "vary": {"axis": "space", "a": "cs", "b": "bm"}, "where": {"fixture": ["kano"]}, "min_cm": 0.5,
		 "reason": "Negative control: a base bone that animates must separate BaseBoneSpace from ComponentSpace."},

		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "gravity_off"}, "where": {"fixture": ["chain"]}, "min_cm": 1.0, "reason": "Gravity must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "damping_high"}, "where": {"fixture": ["chain"]}, "min_cm": 1.0, "reason": "Damping must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "stiffness_high"}, "where": {"fixture": ["chain"]}, "min_cm": 1.0, "reason": "Stiffness must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "world_damping_zero"}, "where": {"fixture": ["chain"], "space": ["cs", "bb"]}, "min_cm": 1.0, "reason": "World damping must change how a moving component drags the chain."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "move_scale_zero"}, "where": {"fixture": ["chain"], "space": ["cs", "bb"]}, "min_cm": 1.0, "reason": "SkelCompMoveScale must change how a moving component drags the chain."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "limit_angle"}, "where": {"fixture": ["chain"]}, "min_cm": 1.0, "reason": "LimitAngle must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "planar"}, "where": {"fixture": ["chain"]}, "min_cm": 1.0, "reason": "PlanarConstraint must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "dummy_off"}, "where": {"fixture": ["chain"], "motion": ["moving"]}, "min_degrees": 5.0, "reason": "The tip dummy bone only steers the rotation of the last real bone."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "constraint"}, "where": {"fixture": ["chain"], "motion": ["moving"]}, "min_cm": 0.1, "reason": "A bone constraint must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "force_world"}, "where": {"fixture": ["chain"]}, "min_cm": 1.0, "reason": "A world space external force must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "force_bone"}, "where": {"fixture": ["chain"], "place": ["near"]}, "min_cm": 1.0, "reason": "A bone space external force must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "simple_force"}, "where": {"fixture": ["chain"]}, "min_cm": 1.0, "reason": "SimpleExternalForce must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "wind"}, "where": {"fixture": ["chain"]}, "min_cm": 0.5, "reason": "Wind must change the motion, which also proves the wind source is alive in this run."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "none", "b": "reset"}, "where": {"fixture": ["chain"]}, "min_cm": 0.1, "reason": "ResetDynamics must change the motion."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "floor_off", "b": "world_floor"}, "where": {"fixture": ["chain"], "place": ["near"]}, "min_cm": 1.0, "reason": "World collision must stop the chain on the floor."},
		{"kind": "differ", "vary": {"axis": "feature", "a": "floor_off", "b": "simple_floor"}, "where": {"fixture": ["chain"], "place": ["near"]}, "min_cm": 1.0, "reason": "Simple world collision must stop the chain on the floor."},

		{"kind": "penetration_reduced", "vary": {"axis": "feature", "a": "none", "b": "sphere"}, "where": {"fixture": ["chain"], "motion": ["still", "sway"]}, "min_reduction_cm": 0.5, "reason": "Spherical limits must push bones out at speeds that do not tunnel through them."},
		{"kind": "penetration_reduced", "vary": {"axis": "feature", "a": "none", "b": "capsule"}, "where": {"fixture": ["chain"], "motion": ["still", "sway"]}, "min_reduction_cm": 1.0, "reason": "Capsule limits must push bones out at speeds that do not tunnel through them."},
		{"kind": "penetration_reduced", "vary": {"axis": "feature", "a": "none", "b": "tapered"}, "where": {"fixture": ["chain"], "motion": ["still", "sway"]}, "min_reduction_cm": 1.0, "reason": "Tapered capsule limits must push bones out at speeds that do not tunnel through them."},
		{"kind": "penetration_reduced", "vary": {"axis": "feature", "a": "none", "b": "box"}, "where": {"fixture": ["chain"], "motion": ["still", "sway"]}, "min_reduction_cm": 1.0, "reason": "Box limits must push bones out at speeds that do not tunnel through them."},
		{"kind": "penetration_reduced", "vary": {"axis": "feature", "a": "none", "b": "plane"}, "where": {"fixture": ["chain"], "motion": ["still", "sway"]}, "min_reduction_cm": 1.0, "reason": "Planar limits must push bones out."},
		{"kind": "limit_angle_reduced", "vary": {"axis": "feature", "a": "none", "b": "limit_angle"}, "where": {"fixture": ["chain"]}, "min_reduction_degrees": 2.0, "reason": "The free chain must pass the angle the limited chain keeps to, which also proves the angle check measures something."},

		{"kind": "profile_equal", "a_profile": "base", "b_profile": "serial", "except": {"feature": ["wind"]}, "max_cm": 0.0001, "max_degrees": 0.001, "reason": "Parallel and serial evaluation must produce the same motion."},
		{"kind": "profile_equal", "a_profile": "dilated", "b_profile": "fps120", "except": {"feature": ["wind"]}, "max_cm": 0.05, "max_degrees": 0.2, "reason": "Half time dilation at 60 fps advances the same steps as 120 fps."},
		{"kind": "profile_equal", "a_profile": "base", "b_profile": "fps30", "a_stride": 2, "a_offset": 1, "skip_frames": 2, "where": {"feature": ["none", "world_damping_zero"], "place": ["near"], "motion": ["still", "moving"]}, "max_cm": 90.0, "reason": "Fixed substepping keeps 30 fps near 60 fps at the same simulation time. This is a budget above the measured 74 cm, to catch the difference growing."},
		{"kind": "profile_equal", "a_profile": "fps120", "b_profile": "base", "a_stride": 2, "a_offset": 1, "skip_frames": 2, "where": {"feature": ["none", "world_damping_zero"], "place": ["near"], "motion": ["still", "moving"]}, "max_cm": 45.0, "reason": "Fixed substepping keeps 120 fps near 60 fps at the same simulation time. This is a budget above the measured 38 cm, to catch the difference growing."},
		{"kind": "profile_differ", "a_profile": "base", "b_profile": "dilated", "where": {"feature": ["none"], "place": ["near"]}, "min_cm": 0.5, "reason": "Negative control: time dilation must take effect."},
		{"kind": "profile_differ", "a_profile": "fps30", "b_profile": "fps30_no_substep", "where": {"fixture": ["chain"], "feature": ["none"], "motion": ["moving"], "place": ["near"]}, "min_cm": 0.01, "reason": "Negative control: turning fixed substepping off must take effect at a low frame rate."}
	]
}
